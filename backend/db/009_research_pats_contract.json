    "checks": {
      "versions_author_check": "(author_kind = 'human' OR author_kind = 'unknown' OR author_kind = 'codex' OR author_kind = 'pat') AND ((author_kind = 'codex') = (author_conversation_id IS NOT NULL)) AND ((author_kind = 'pat') = (author_credential_id IS NOT NULL)) AND ((author_kind = 'pat') = (author_name IS NOT NULL))"
    }
  },
  "post_versions": {
