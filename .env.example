COMPOSE_PROJECT_NAME=anxious-s13-back
API_PORT=28080
WEB_PORT=23000
GATEWAY_PORT=28000
# Set actual git SHA/build time before build; examples are not a deployable release.
RELEASE_SHA=
RELEASE_BUILT_AT=
NEXT_PUBLIC_BASE_PATH=
# Real OAuth remains disabled until the owned app and protected callback are ready.
OAUTH_MODE=disabled
AUTH_ORIGIN=https://m2.invalid
GITHUB_CLIENT_ID=
ALLOW_INSECURE_LOOPBACK=false
ALLOW_PUBLIC_IP_HTTP=false
