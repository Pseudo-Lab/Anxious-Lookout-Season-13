{
  "apiVersion": "v1", "kind": "List", "items": [
    {
      "apiVersion": "admissionregistration.k8s.io/v1", "kind": "ValidatingAdmissionPolicy",
      "metadata": {"name": "${RUNNER_POLICY_NAME}"},
      "spec": {
        "failurePolicy": "Fail",
        "matchConstraints": {
          "matchPolicy": "Exact",
          "namespaceSelector": {"matchLabels": {"kubernetes.io/metadata.name": "${RUNNER_TEST_NAMESPACE}"}},
          "resourceRules": [
            {"apiGroups": [""], "apiVersions": ["v1"], "operations": ["CREATE", "UPDATE"], "resources": ["pods"], "scope": "Namespaced"}
          ]
        },
        "validations": [
          {"expression": "false", "message": "runner-draft-gate: template envelope has not passed schema and admission review"},
          {"expression": "request.userInfo.username == 'system:serviceaccount:${RUNNER_TEST_NAMESPACE}:runner-controller'", "message": "runner-creator: unexpected caller"},
          {"expression": "object.metadata.namespace == '${RUNNER_TEST_NAMESPACE}' && object.metadata.name == '${RUNNER_POD_NAME}'", "message": "runner-identity: unexpected namespace or name"},
          {"expression": "has(object.metadata.labels) && object.metadata.labels.size() == 4 && object.metadata.labels['anxious.io/managed'] == 'user-runner' && object.metadata.labels['anxious.io/owner'] == '${RUNNER_SYNTHETIC_OWNER}' && object.metadata.labels['anxious.io/state'] == '${RUNNER_SYNTHETIC_STATE}' && object.metadata.labels['anxious.io/generation'] == '${RUNNER_GENERATION}'", "message": "runner-labels: identity mismatch"},
          {"expression": "(!has(object.metadata.ownerReferences) || object.metadata.ownerReferences.size() == 0) && (!has(object.metadata.finalizers) || object.metadata.finalizers.size() == 0)", "message": "runner-metadata: owner references or finalizers forbidden"},
          {"expression": "object.spec.serviceAccountName == 'runner-workload' && has(object.spec.automountServiceAccountToken) && !object.spec.automountServiceAccountToken", "message": "runner-service-account: wrong identity or token automount"},
          {"expression": "(!has(object.spec.hostNetwork) || !object.spec.hostNetwork) && (!has(object.spec.hostPID) || !object.spec.hostPID) && (!has(object.spec.hostIPC) || !object.spec.hostIPC)", "message": "runner-host: host namespaces forbidden"},
          {"expression": "object.spec.containers.size() == 1 && object.spec.containers[0].name == 'runner' && object.spec.containers[0].image == '${RUNNER_IMAGE_DIGEST}' && (!has(object.spec.initContainers) || object.spec.initContainers.size() == 0) && (!has(object.spec.ephemeralContainers) || object.spec.ephemeralContainers.size() == 0)", "message": "runner-containers: unexpected image or additional container"},
          {"expression": "object.spec.volumes.size() == 4 && object.spec.volumes.all(v, !has(v.projected) && !has(v.hostPath)) && object.spec.volumes.exists(v, v.name == 'native' && has(v.persistentVolumeClaim) && v.persistentVolumeClaim.claimName == '${RUNNER_NATIVE_PVC}') && object.spec.volumes.exists(v, v.name == 'control' && has(v.persistentVolumeClaim) && v.persistentVolumeClaim.claimName == '${RUNNER_CONTROL_PVC}') && object.spec.volumes.exists(v, v.name == 'transport' && has(v.secret) && v.secret.secretName == '${RUNNER_TRANSPORT_SECRET}') && object.spec.volumes.exists(v, v.name == 'tmp' && has(v.emptyDir))", "message": "runner-storage: foreign volume or token projection"},
          {"expression": "has(object.spec.securityContext) && object.spec.securityContext.runAsNonRoot && object.spec.securityContext.runAsUser == 10001 && object.spec.securityContext.runAsGroup == 10001 && object.spec.securityContext.seccompProfile.type == 'RuntimeDefault'", "message": "runner-pod-security: wrong execution identity"},
          {"expression": "object.spec.containers.all(c, has(c.securityContext) && !c.securityContext.allowPrivilegeEscalation && c.securityContext.readOnlyRootFilesystem && c.securityContext.capabilities.drop == ['ALL'] && (!has(c.securityContext.capabilities.add) || c.securityContext.capabilities.add.size() == 0) && (!has(c.securityContext.privileged) || !c.securityContext.privileged))", "message": "runner-container-security: forbidden privilege"}
        ]
      }
    },
    {
      "apiVersion": "admissionregistration.k8s.io/v1", "kind": "ValidatingAdmissionPolicyBinding",
      "metadata": {"name": "${RUNNER_POLICY_NAME}"},
      "spec": {"policyName": "${RUNNER_POLICY_NAME}", "validationActions": ["Deny"], "matchResources": {
        "namespaceSelector": {"matchLabels": {"kubernetes.io/metadata.name": "${RUNNER_TEST_NAMESPACE}"}}
      }}
    },
    {
      "apiVersion": "admissionregistration.k8s.io/v1", "kind": "ValidatingAdmissionPolicy",
      "metadata": {"name": "${RUNNER_SUBRESOURCE_POLICY_NAME}"},
      "spec": {
        "failurePolicy": "Fail",
        "matchConstraints": {
          "matchPolicy": "Exact",
          "namespaceSelector": {"matchLabels": {"kubernetes.io/metadata.name": "${RUNNER_TEST_NAMESPACE}"}},
          "resourceRules": [
            {"apiGroups": [""], "apiVersions": ["v1"], "operations": ["UPDATE"], "resources": ["pods/ephemeralcontainers"], "scope": "Namespaced"},
            {"apiGroups": [""], "apiVersions": ["v1"], "operations": ["CONNECT"], "resources": ["pods/exec", "pods/attach", "pods/portforward"], "scope": "Namespaced"}
          ]
        },
        "validations": [{"expression": "false", "message": "runner-subresource: interactive execution and ephemeral containers forbidden"}]
      }
    },
    {
      "apiVersion": "admissionregistration.k8s.io/v1", "kind": "ValidatingAdmissionPolicyBinding",
      "metadata": {"name": "${RUNNER_SUBRESOURCE_POLICY_NAME}"},
      "spec": {"policyName": "${RUNNER_SUBRESOURCE_POLICY_NAME}", "validationActions": ["Deny"], "matchResources": {
        "namespaceSelector": {"matchLabels": {"kubernetes.io/metadata.name": "${RUNNER_TEST_NAMESPACE}"}}
      }}
    }
  ]
}
