{
  "apiVersion": "v1", "kind": "Secret",
  "metadata": {"name": "transport-synthetic", "namespace": "${RUNNER_TEST_NAMESPACE}", "labels": {
    "anxious.io/owner": "${RUNNER_SYNTHETIC_OWNER}", "anxious.io/state": "${RUNNER_SYNTHETIC_STATE}"
  }},
  "immutable": true, "type": "Opaque",
  "data": {"token": "${RUNNER_PRIVATE_TRANSPORT_TOKEN_BASE64}"}
}
