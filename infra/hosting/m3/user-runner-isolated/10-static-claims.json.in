{
  "apiVersion": "v1", "kind": "List",
  "items": [
    {
      "apiVersion": "v1", "kind": "PersistentVolumeClaim",
      "metadata": {"name": "native-synthetic", "namespace": "${RUNNER_TEST_NAMESPACE}", "labels": {
        "anxious.io/owner": "${RUNNER_SYNTHETIC_OWNER}", "anxious.io/state": "${RUNNER_SYNTHETIC_STATE}"
      }},
      "spec": {
        "storageClassName": "${RUNNER_STATIC_STORAGE_CLASS}", "volumeName": "${RUNNER_NATIVE_PV}",
        "accessModes": ["${RUNNER_APPROVED_ACCESS_MODE}"], "volumeMode": "Filesystem",
        "resources": {"requests": {"storage": "${RUNNER_NATIVE_SIZE}"}}
      }
    },
    {
      "apiVersion": "v1", "kind": "PersistentVolumeClaim",
      "metadata": {"name": "control-synthetic", "namespace": "${RUNNER_TEST_NAMESPACE}", "labels": {
        "anxious.io/owner": "${RUNNER_SYNTHETIC_OWNER}", "anxious.io/state": "${RUNNER_SYNTHETIC_STATE}"
      }},
      "spec": {
        "storageClassName": "${RUNNER_STATIC_STORAGE_CLASS}", "volumeName": "${RUNNER_CONTROL_PV}",
        "accessModes": ["${RUNNER_APPROVED_ACCESS_MODE}"], "volumeMode": "Filesystem",
        "resources": {"requests": {"storage": "${RUNNER_CONTROL_SIZE}"}}
      }
    }
  ]
}
