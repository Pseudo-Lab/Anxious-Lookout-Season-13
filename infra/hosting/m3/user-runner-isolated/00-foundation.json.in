{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1", "kind": "Namespace",
      "metadata": {"name": "${RUNNER_TEST_NAMESPACE}", "labels": {
        "anxious.io/purpose": "isolated-runner-rehearsal",
        "pod-security.kubernetes.io/enforce": "restricted",
        "pod-security.kubernetes.io/enforce-version": "${RUNNER_PSA_VERSION}",
        "pod-security.kubernetes.io/audit": "restricted",
        "pod-security.kubernetes.io/audit-version": "${RUNNER_PSA_VERSION}",
        "pod-security.kubernetes.io/warn": "restricted",
        "pod-security.kubernetes.io/warn-version": "${RUNNER_PSA_VERSION}"
      }}
    },
    {
      "apiVersion": "v1", "kind": "ResourceQuota",
      "metadata": {"name": "runner-bootstrap-no-pods", "namespace": "${RUNNER_TEST_NAMESPACE}"},
      "spec": {"hard": {"count/pods": "0"}}
    },
    {
      "apiVersion": "networking.k8s.io/v1", "kind": "NetworkPolicy",
      "metadata": {"name": "runner-default-deny", "namespace": "${RUNNER_TEST_NAMESPACE}"},
      "spec": {"podSelector": {}, "policyTypes": ["Ingress", "Egress"], "ingress": [], "egress": []}
    },
    {
      "apiVersion": "v1", "kind": "ServiceAccount",
      "metadata": {"name": "runner-controller", "namespace": "${RUNNER_TEST_NAMESPACE}"},
      "automountServiceAccountToken": false
    },
    {
      "apiVersion": "v1", "kind": "ServiceAccount",
      "metadata": {"name": "runner-workload", "namespace": "${RUNNER_TEST_NAMESPACE}"},
      "automountServiceAccountToken": false
    }
  ]
}
