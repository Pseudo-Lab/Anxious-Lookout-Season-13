{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Issue18 fixed single-node D4 rollout inputs",
  "type": "object", "additionalProperties": false,
  "required": ["postImagesStorageClass", "version", "runtimeImage", "runnerImage", "provisionerImageId", "api", "hostApi", "namespaceUid", "podCIDR", "node", "providerAccountId", "allowlist", "maxPods", "idleSeconds", "nativeSizeGiB", "controlSizeGiB", "research"],
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"},
    "image": {"type": "string", "pattern": "^[a-zA-Z0-9./:_-]+@sha256:[a-f0-9]{64}$"},
    "path": {"type": "string", "pattern": "^/[A-Za-z0-9_./-]+$"},
    "size": {"type": "integer", "minimum": 1, "maximum": 999999}
  },
  "properties": {
    "version": {"const": 1},
    "postImagesStorageClass": {"type": "string", "maxLength": 253, "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*$"},
    "runtimeImage": {"$ref": "#/$defs/image"}, "runnerImage": {"$ref": "#/$defs/image"},
    "provisionerImageId": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "api": {"type": "string", "pattern": "^https://"}, "hostApi": {"type": "string", "pattern": "^https://"},
    "namespaceUid": {"$ref": "#/$defs/uuid"},
    "podCIDR": {"type": "string", "description": "Canonical IPv4 network; renderer checks using ipaddress."},
    "node": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"},
    "providerAccountId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,200}$"},
    "allowlist": {"oneOf": [{"type": "null"}, {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/uuid"}}]},
    "maxPods": {"type": "integer", "minimum": 1, "maximum": 100},
    "idleSeconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "nativeSizeGiB": {"$ref": "#/$defs/size"}, "controlSizeGiB": {"$ref": "#/$defs/size"},
    "research": {"type": "object", "additionalProperties": false, "required": ["enable"],
                 "description": "#101 (7) required research flag. enable: api RESEARCH_AGENT_API_ENABLE and CODEX_RUNNER_RESEARCH_API_ENABLE, runner-controller CODEX_RUNNER_RESEARCH_API_ENABLE (runner Pod RUNNER_RESEARCH_API_ENABLE). Written as exact true/false; inherited values are dropped.",
                 "properties": {"enable": {"type": "boolean"}}},
    "rollout": {"type": "object", "additionalProperties": false,
                "description": "#101 (1) optional rolling runner replacement. Present (even {}) = the runner-controller target is runnerImage (RUNNER_TARGET_IMAGE) with the runner flags; absent = no rolling replacement.",
                "properties": {"maxParallel": {"type": "integer", "minimum": 1, "maximum": 3},
                               "turnDeadlineSeconds": {"type": "integer", "minimum": 60, "maximum": 86400},
                               "canarySeconds": {"type": "integer", "minimum": 60, "maximum": 86400},
                               "canaryOwners": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/uuid"}}}},
    "stream": {"type": "object", "additionalProperties": false, "required": ["enable", "text", "trace"],
               "description": "#94 (9) optional #90 stream flags; absent = all off. enable: api RESEARCH_STREAM_ENABLE; text: CODEX_RUNNER_STREAM_TEXT (api, runner-controller); trace: CODEX_RUNNER_STREAM_TRACE (api, runner-controller) and api STREAM_TRACE. The renderer owns these keys: inherited values are dropped.",
               "properties": {"enable": {"type": "boolean"}, "text": {"type": "boolean"}, "trace": {"type": "boolean"},
                              "retired": {"type": "boolean", "description": "#95 B1 optional: CODEX_RUNNER_STREAM_RETIRED (api, runner-controller) -> runner Pod STREAM_RETIRED, the retired-literal holdback switch; absent = false"}}}
  }
}
