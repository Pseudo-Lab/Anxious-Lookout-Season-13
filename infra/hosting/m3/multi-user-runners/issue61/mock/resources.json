  {
   "apiVersion": "apps/v1",
   "kind": "Deployment",
   "metadata": {
    "labels": {
     "app": "runner-controller"
    },
    "name": "runner-controller",
    "namespace": "runner-control"
   },
   "spec": {
    "replicas": 1,
    "selector": {
     "matchLabels": {
      "app": "runner-controller"
     }
    },
    "strategy": {
     "type": "Recreate"
    },
    "template": {
     "metadata": {
      "labels": {
       "app": "runner-controller"
      }
     },
     "spec": {
      "containers": [
       {
        "command": [
         "python",
         "-B",
         "-m",
         "ops.runner_controller_service"
        ],
        "env": [
         {
          "name": "CODEX_USER_RUNNERS_ENABLE",
          "value": "true"
         },
         {
          "name": "CODEX_USER_RUNNER_MAX_PODS",
          "value": "3"
         },
         {
          "name": "CODEX_USER_RUNNER_IDLE_SECONDS",
          "value": "1800"
         },
         {
          "name": "CODEX_RUNNER_NATIVE_SIZE_GIB",
          "value": "5"
         },
         {
          "name": "CODEX_RUNNER_CONTROL_SIZE_GIB",
          "value": "1"
         },
         {
          "name": "CODEX_USER_RUNNER_ALLOWLIST",
          "value": "ff4b718f-de46-4c10-9195-c993eff9ded9"
         },
         {
          "name": "RUNNER_NAMESPACE",
          "value": "codex-runner"
         },
         {
          "name": "RUNNER_NAMESPACE_UID",
          "value": "52fe679d-33b1-4e84-b377-443ff61fb38c"
         },
         {
          "name": "RUNNER_POD_CIDR",
          "value": "10.42.0.0/16"
         },
         {
          "name": "RUNNER_NODE_NAME",
          "value": "anxious-lookout"
         },
         {
          "name": "CONTROLLER_DATABASE_URL_FILE",
          "value": "/run/runner-db/controller-url"
         },
         {
          "name": "OBSERVER_DATABASE_URL_FILE",
          "value": "/run/runner-db/observer-url"
         }
        ],
        "image": "docker.io/library/anxious-dev-runtime@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "imagePullPolicy": "Never",
        "name": "controller",
        "resources": {
         "requests": {
          "cpu": "50m",
          "memory": "128Mi"
         }
        },
        "securityContext": {
         "allowPrivilegeEscalation": false,
         "capabilities": {
          "drop": [
           "ALL"
          ]
         },
         "readOnlyRootFilesystem": true
        },
        "volumeMounts": [
         {
          "mountPath": "/run/runner-db",
          "name": "db",
          "readOnly": true
         },
         {
          "mountPath": "/tmp",
          "name": "tmp"
         }
        ]
       }
      ],
      "enableServiceLinks": false,
      "securityContext": {
       "fsGroup": 10001,
       "runAsGroup": 10001,
       "runAsNonRoot": true,
       "runAsUser": 10001,
       "seccompProfile": {
        "type": "RuntimeDefault"
       }
      },
      "serviceAccountName": "runner-controller",
      "volumes": [
       {
        "name": "db",
        "secret": {
         "defaultMode": 288,
         "secretName": "runner-controller-db"
        }
       },
       {
        "emptyDir": {
         "medium": "Memory",
         "sizeLimit": "16Mi"
        },
        "name": "tmp"
       }
      ]
     }
    }
   }
  },
