#!/bin/sh
set -eu
exec /usr/bin/docker run --rm --pull=never --cidfile=/run/issue16-observer/container-id --user=0:0 --read-only --cap-drop=ALL --security-opt=no-new-privileges --tmpfs=/tmp:rw,nosuid,nodev,size=64m -e PYTHONPATH=/app --mount type=bind,src=/usr/local/lib/anxious-lookout/issue16,dst=/rollout,readonly --network=host --mount type=bind,src=/etc/anxious-lookout/issue16/observer,dst=/private,readonly -e CODEX_USER_RUNNERS_ENABLE=true -e CODEX_USER_RUNNER_MAX_PODS=3 -e CODEX_USER_RUNNER_IDLE_SECONDS=1800 -e CODEX_RUNNER_NATIVE_SIZE_GIB=5 -e CODEX_RUNNER_CONTROL_SIZE_GIB=1 -e CODEX_USER_RUNNER_ALLOWLIST=3cb453bf-d870-40dc-b7e1-3a58aa0cbaf2 -e OBSERVER_DATABASE_URL_FILE=/private/database-url --cap-add=DAC_READ_SEARCH --mount type=bind,src=/var/lib/anxious-lookout/issue16-d4/observer,dst=/var/lib/anxious-lookout/issue16-d4/observer --pid=host --cgroupns=host --cap-add=SYS_PTRACE --mount type=bind,src=/proc,dst=/host/proc,readonly --mount type=bind,src=/run/k3s/containerd/containerd.sock,dst=/run/k3s/containerd/containerd.sock,readonly --mount type=bind,src=/usr/local/bin/crictl,dst=/usr/local/bin/crictl,readonly --mount type=bind,src=/var/lib/anxious-lookout/user-runners,dst=/var/lib/anxious-lookout/user-runners,readonly,bind-propagation=rslave --entrypoint=python sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa -B /rollout/worker.py observer --inputs /private/inputs.json --limit 10 --cursor-file /var/lib/anxious-lookout/issue16-d4/observer/cursor.json --idle
