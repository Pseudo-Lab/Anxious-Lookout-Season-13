#!/bin/sh
set -eu
exec /usr/bin/docker run --rm --pull=never --cidfile=/run/issue16-controller/container-id --user=0:0 --read-only --cap-drop=ALL --security-opt=no-new-privileges --tmpfs=/tmp:rw,nosuid,nodev,size=64m -e PYTHONPATH=/app --mount type=bind,src=/usr/local/lib/anxious-lookout/issue16,dst=/rollout,readonly --network=host --cap-add=SYS_ADMIN --cap-add=MKNOD --cap-add=CHOWN --cap-add=DAC_OVERRIDE --cap-add=FOWNER --device=/dev/loop-control '--device-cgroup-rule=b 7:* rwm' --security-opt=apparmor=unconfined --mount type=bind,src=/dev,dst=/dev --mount type=bind,src=/var/lib/anxious-lookout/user-runners,dst=/var/lib/anxious-lookout/user-runners,bind-propagation=rshared --mount type=bind,src=/var/lib/anxious-lookout/issue16-d4/provision-output,dst=/var/lib/anxious-lookout/issue16-d4/provision-output --mount type=bind,src=/etc/anxious-lookout/issue16/controller,dst=/private,readonly -e CODEX_USER_RUNNERS_ENABLE=true -e CODEX_USER_RUNNER_MAX_PODS=3 -e CODEX_USER_RUNNER_IDLE_SECONDS=1800 -e CODEX_RUNNER_NATIVE_SIZE_GIB=5 -e CODEX_RUNNER_CONTROL_SIZE_GIB=1 -e CODEX_USER_RUNNER_ALLOWLIST=3cb453bf-d870-40dc-b7e1-3a58aa0cbaf2 -e DATABASE_URL_FILE=/private/database-url -e CONTROLLER_DATABASE_URL_FILE=/private/database-url --entrypoint=python sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa -B /rollout/worker.py controller --inputs /private/inputs.json --limit 10 --outputs /var/lib/anxious-lookout/issue16-d4/provision-output
