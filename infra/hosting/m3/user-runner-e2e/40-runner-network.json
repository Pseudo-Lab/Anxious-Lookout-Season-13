{
  "apiVersion": "cilium.io/v2",
  "kind": "CiliumNetworkPolicy",
  "metadata": {"name": "runner-callback-draft", "namespace": "codex-runner"},
  "spec": {
    "endpointSelector": {},
    "ingress": [
      {
        "fromEndpoints": [{"matchLabels": {
          "k8s:io.kubernetes.pod.namespace": "m2-hosting",
          "k8s:app": "hosting-api"
        }}],
        "toPorts": [{"ports": [{"port": "8080", "protocol": "TCP"}]}]
      },
      {
        "fromEndpoints": [{"matchLabels": {
          "k8s:io.kubernetes.pod.namespace": "runner-control",
          "k8s:app": "runner-controller"
        }}],
        "toPorts": [{"ports": [{"port": "8080", "protocol": "TCP"}]}]
      }
    ],
    "ingressDeny": [{"fromEndpoints": [
      {"matchLabels": {"k8s:io.kubernetes.pod.namespace": "codex-runner"}},
      {"matchLabels": {"k8s:io.kubernetes.pod.namespace": "codex-trial"}}
    ]}],
    "egress": [
      {
        "toEndpoints": [{"matchLabels": {
          "k8s:io.kubernetes.pod.namespace": "codex-broker",
          "k8s:app": "codex-broker"
        }}],
        "toPorts": [{"ports": [{"port": "8080", "protocol": "TCP"}]}]
      },
      {
        "toEndpoints": [{"matchLabels": {
          "k8s:io.kubernetes.pod.namespace": "kube-system",
          "k8s:k8s-app": "kube-dns"
        }}],
        "toPorts": [{"ports": [{"port": "53", "protocol": "UDP"}, {"port": "53", "protocol": "TCP"}]}]
      },
      {
        "toEndpoints": [{"matchLabels": {
          "k8s:io.kubernetes.pod.namespace": "m2-hosting",
          "k8s:app": "hosting-api"
        }}],
        "toPorts": [{"ports": [{"port": "8081", "protocol": "TCP"}]}]
      },
      {
        "toEntities": ["world"],
        "toPorts": [{"ports": [{"port": "443", "protocol": "TCP"}]}]
      }
    ],
    "egressDeny": [
      {"toEndpoints": [
        {"matchLabels": {"k8s:io.kubernetes.pod.namespace": "codex-runner"}},
        {"matchLabels": {"k8s:io.kubernetes.pod.namespace": "codex-trial"}}
      ]},
      {"toEntities": ["kube-apiserver"]},
      {
        "toEntities": ["all"],
        "toPorts": [{"ports": [{"port": "6443", "protocol": "TCP"}]}]
      }
    ]
  }
}
