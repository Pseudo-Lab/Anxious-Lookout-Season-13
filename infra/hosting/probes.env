# Exec deadlines include interpreter startup; HTTP requests retain a 2s bound.
M2_API_PROBE_TIMEOUT_SECONDS=10
M2_API_STARTUP_PERIOD_SECONDS=10
M2_API_STARTUP_FAILURE_THRESHOLD=20
M2_API_READINESS_PERIOD_SECONDS=10
M2_API_LIVENESS_PERIOD_SECONDS=20
M2_WEB_PROBE_TIMEOUT_SECONDS=5
M2_WEB_STARTUP_PERIOD_SECONDS=5
M2_WEB_STARTUP_FAILURE_THRESHOLD=30
M2_WEB_PROBE_JS="fetch('http://127.0.0.1:8080/version.json',{signal:AbortSignal.timeout(2000)}).then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"
