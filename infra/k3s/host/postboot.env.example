# Install as /etc/anxious-lookout/postboot.env, root:root mode 0600.
# Replace both node addresses with the actual host values before enabling.
NODE_PRIVATE_IPV4=10.0.0.107
NODE_PUBLIC_IPV4=198.51.100.10
DOCKER_CONTAINER=hermes
DOCKER_NETWORK_NAME=hermes_default
VALIDATION_DIR=/usr/local/lib/anxious-k3s-validation
