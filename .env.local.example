# 웹(Next.js)에는 서버 비밀정보가 없습니다. 인증·DB 비밀은 backend(FastAPI)에 둡니다.

# 외부 base 경로(빌드 시점에 고정). 전용 Host 루트 배포면 비워 둡니다. prefix 배포면 "/m2" 형식.
NEXT_PUBLIC_BASE_PATH=

# `pnpm run version:write`가 public/version.json을 만들 때 쓰는 build metadata(웹 이미지 빌드에서 주입).
# WEB_GIT_SHA=<40자리 git commit SHA>
# WEB_BUILT_AT=2026-10-06T00:00:00Z
